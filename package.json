{
  "name": "trading-research",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "uv run --no-sync ruff check . && uv run --no-sync ruff format --check .",
    "dev": "turbo run dev",
    "deps:install": "pnpm install --frozen-lockfile && uv sync --frozen",
    "catalog": "uv run --no-sync research catalog",
    "backtest": "uv run --no-sync research backtest",
    "verify": "uv run --no-sync research verify",
    "rehearse": "uv run --no-sync research rehearse",
    "api": "uv run --no-sync research serve",
    "cloud:install": "sh scripts/cloud-install.sh",
    "cloud:start": "python3 --version",
    "dev:tailscale": "node scripts/tailscale-dev.mjs start",
    "dev:tailscale:status": "node scripts/tailscale-dev.mjs status",
    "dev:tailscale:stop": "node scripts/tailscale-dev.mjs stop"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  }
}
